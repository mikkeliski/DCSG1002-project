---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="modal" id={id} data-modal hidden>
  <slot />
</div>

<style>
  .modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: rgba(0, 0, 0, 0.6);
  }
</style>
