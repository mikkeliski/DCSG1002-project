---
interface Props {
  name: string;
  icon?: string;
  color?: string;
  text?: string;
  href?: string;
}

const { name, icon, color, text, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="card" href={href}>
  {icon && (
    <span class="icon" style={`background: ${color ?? 'var(--panel2)'}`} aria-hidden="true">
      {icon}
    </span>
  )}
  <div>
    <h3>{name}</h3>
    {text && <p>{text}</p>}
  </div>
</Tag>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
  }

  a.card:hover {
    border-color: var(--green);
  }

  a.card:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }

  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 12px;
    font-size: 34px;
  }

  h3 {
    margin: 0;
  }

  p {
    margin: 4px 0 0;
    color: var(--mute);
    font-size: 14px;
  }
</style>
