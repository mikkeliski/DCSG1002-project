---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="banner">
  <div class="wrap">
    <h1>{title}</h1>
    <p><slot /></p>
  </div>
</section>
<style>
  .banner {
    background: var(--panel2);
    border-bottom: 1px solid var(--line);
    padding: 32px 0;
  }

  .banner h1 {
    margin: 0 0 8px;
    font-size: 30px;
  }

  .banner p {
    margin: 0;
    max-width: 700px;
    color: #c3cad4;
  }

  .tag {
    display: inline-block;
    margin-right: 6px;
    padding: 2px 10px;
    background: var(--panel2);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--mute);

    font-size: 12px;
  }
</style>
