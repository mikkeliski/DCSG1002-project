---
import { getCollection } from 'astro:content';
import { getLang, languageNames, localePath, locales, switchLangPath, useTranslations } from '@i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const resourceTypes = (await getCollection('resourceTypes'))
  .sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname.replace(/\/$/, '');

// Språkvelger: lenker til samme side på de andre språkene
const otherLangs = locales.filter((l) => l !== lang);
---

<header id="hdr" class="top">
  <div class="wrap nav">
    <a class="logo" href={localePath(lang, '/')}><i></i>ModHavn</a>
    {resourceTypes.map(({ data }) => {
      const href = localePath(lang, `/${data.id}`);
      return (
        <a class:list={['l', { on: path === href || path.startsWith(`${href}/`) }]} href={href}>
          {data.label[lang]}
        </a>
      );
    })}
    <a class="l" href={localePath(lang, '/about')}>{t.header.about}</a>
    <a class="l" href={localePath(lang, '/learn')}>{t.header.learn}</a>
    {otherLangs.map((l) => (
      <a class="l lang" href={switchLangPath(Astro.url.pathname, l)} hreflang={l} lang={l}>
        {languageNames[l]}
      </a>
    ))}
  </div>
</header>
<style>
  /* Språkvelgeren legger seg ytterst til høyre i menyen */
  .lang {
    margin-left: auto;
  }

  :root {
    --bg: #16181c;
    --panel: #1e2126;
    --panel2: #262a31;
    --line: #323741;
    --text: #e6e8eb;
    --mute: #9aa1ad;
    --green: #1bd96a;
    --green-d: #13a850;
  }

  header.top {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 56px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 20px;
  }

  .logo i {
    display: inline-block;
    width: 24px;
    height: 24px;
    background: var(--green);
    border-radius: 6px;
  }

  .nav a.l {
    color: var(--mute);
    font-weight: 600;
  }

  .nav a.l:hover {
    color: var(--text);
  }

  .nav a.l.on {
    color: var(--green);
  }


</style>
