---
const pages = [
  { href: '/mods', label: 'Mods' },
  { href: '/texturepacks', label: 'Texture packs' },
  { href: '/modpacks', label: 'Mod packs' }
];

const path = Astro.url.pathname;
---

<header id="hdr" class="top">
  <div class="wrap nav">
    <a class="logo" href="/"><i></i>ModHavn</a>
    {pages.map((p) => (
    <a class={path.startsWith(p.href) ? 'l on' : 'l'} href={p.href}>
      {p.label}
    </a>
    ))}
  </div>
</header>
