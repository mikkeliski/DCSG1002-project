---
import Global from '@layouts/Global.astro';
import Quiz from '@components/Quiz.astro';
---

<Global title="Resultat og quiz – ModHavn">
  <main class="wrap result">
    <div class="box">
      <h1>✅ Du fant den ekte lenken!</h1>
      <p id="summary"></p>
      <h2>Slik kjenner du igjen en falsk nedlastingslenke</h2>
      <ul class="list">
        <li><b>Les adressen.</b> Hold musepekeren over knappen. Går den til et annet domene enn siden du er på?</li>
        <li><b>Sjekk filtypen.</b> En Minecraft-mod er en <code>.jar</code>. En <code>.exe</code>, <code>.msi</code> eller <code>.bat</code> er et rødt flagg.</li>
        <li><b>Se etter «Annonse».</b> Store, fargerike «Download»-knapper er ofte reklame.</li>
        <li><b>Ikke stol på varsler.</b> Nettsider kan ikke vite om PC-en din har virus.</li>
        <li><b>Gå til kilden.</b> Last helst ned fra modens offisielle side og unngå mellomsider med mye reklame.</li>
        <li><b>Ingen «må installere kodek/oppdatering/nedlastingsbehandler».</b> Det trenger du ikke.</li>
      </ul>
      <a class="btn" id="again" href="/mods">Prøv igjen</a>
    </div>

    <div class="box">
      <h2>Quiz: Har du skjønt det?</h2>
      <Quiz />
    </div>
  </main>
</Global>

<script>
  import { store } from '@lib/store';

  const fakes = store.get('fakeClicks', 0);
  document.getElementById('summary')!.textContent =
    fakes === 0
      ? 'Du fant den på første forsøk uten å klikke på en eneste falsk knapp. Imponerende!'
      : `Du klikket på ${fakes} falsk${fakes === 1 ? ' knapp' : 'e knapper'} før du fant den ekte. Det er helt normalt, og nettopp slike knapper er laget for å lure folk.`;

  const again = document.getElementById('again') as HTMLAnchorElement;
  again.href = store.get('lastDownload', '/mods');
</script>

<style>
  .result {
    max-width: 800px;
    margin-top: 24px;
  }

  .box + .box {
    margin-top: 20px;
  }

  h1 {
    margin-top: 0;
  }

  .list li {
    margin: 6px 0;
  }
</style>
