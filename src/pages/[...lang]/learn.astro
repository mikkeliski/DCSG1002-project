---
import Global from '@layouts/Global.astro'
import Banner from '@components/Banner.astro'
import { Image } from 'astro:assets';
import Malvertising from '@images/Malvertising.svg';
import { langParams, useTranslations } from '@i18n/utils';

export function getStaticPaths() {
  return langParams.map((params) => ({ params }));
}

const t = useTranslations(Astro.currentLocale).learn;
---
<Global title={t.title}>
  <Banner title={t.banner}>
  </Banner>

  <main class="wrap">
    <article class="box explainer">
      <h2>{t.whatTitle}</h2>
      <p>{t.whatText}</p>

      <figure>
        <Image src={Malvertising} alt={t.figureAlt} class="example" />
        <figcaption>{t.figureCaption}</figcaption>
      </figure>

      <h3>{t.spotTitle}</h3>
      <ul>
        {t.spotList.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article class="box explainer">
      <h2>{t.avoidTitle}</h2>
      <p>{t.avoidText}</p>
      <h3>{t.habitsTitle}</h3>
      <ul>
        {t.habitsList.map((item) => <li>{item}</li>)}
      </ul>

      <div class="note">{t.note}</div>
      <h3>{t.adblockTitle}</h3>
      <p set:html={t.adblockHtml} />
    </article>

  </main>
</Global>

<style>
  .explainer {
    max-width: 760px;
    margin: 24px auto;
  }

  .explainer p,
  .explainer li {
    max-width: 68ch;
  }

  figure {
    margin: 20px 0;
    width: 50%;
  }

  .example {
    display: block;
    width: 100%;
    height: auto;
    padding: 12px;
    background-color: white;
    border-radius: 10px;
  }

  figcaption {
    margin-top: 8px;
    color: var(--mute);
    font-size: 13px;
  }

  @media (max-width: 800px) {
    figure {
      width: 100%;
    }
  }
</style>
