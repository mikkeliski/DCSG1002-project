---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import Global from '@layouts/Global.astro';
import Banner from '@components/Banner.astro';
import CardList from '@components/CardList.astro';
import { fill, getLang, langParams, localePath, useTranslations } from '@i18n/utils';

export const getStaticPaths = (async () => {
  const resourceTypes = await getCollection('resourceTypes');

  return langParams.flatMap((lang) =>
    resourceTypes.map(({ data }) => ({
      params: { ...lang, resourceType: data.id },
      props: { type: data },
    })),
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { type } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const label = type.label[lang];
const entries = await getCollection(type.id);

const items = entries.map(({ data }) => ({
  name: data.name,
  icon: data.icon,
  color: data.color,
  text: data.feat[0],
  href: localePath(lang, `/${type.id}/${data.id}`),
}));
---

<Global title={`${label} – ModHavn`}>
  <Banner title={label}>{type.description[lang]}</Banner>

  <main class="wrap">
    {items.length > 0 ? (
      <CardList items={items} />
    ) : (
      <p class="empty">{fill(t.resourceList.empty, { label: label.toLowerCase() })}</p>
    )}
  </main>
</Global>
