---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import Global from '@layouts/Global.astro';
import { getLang, langParams, localePath, useTranslations } from '@i18n/utils';

export const getStaticPaths = (async () => {
  const resourceTypes = await getCollection('resourceTypes');

  const paths = await Promise.all(
    resourceTypes.map(async ({ data: type }) => {
      const entries = await getCollection(type.id);

      return langParams.flatMap((lang) =>
        entries.map(({ data }) => ({
          params: { ...lang, resourceType: type.id, id: data.id },
          props: { type, item: data },
        })),
      );
    })
  );

  return paths.flat();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { type, item } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const loader = 'loader' in item ? item.loader : undefined;
const version = 'modpackVersion' 
  in item ? item.modpackVersion : item.modVersion;
const formatNumber = (n: number) => n.toLocaleString(t.meta.numberLocale);
const downloadUrl = `https://modhavn.example/${type.id}/${item.id}/download`;
---

<Global title={`${item.name} – ModHavn`}>
  <main class="wrap">
    <div class="hero">
      <div class="icon" style={`background: ${item.color}`} 
      aria-hidden="true">{item.icon}</div>
      <div>
        <h1>{item.name}</h1>
        <span class="tag">{type.label[lang]}</span>
        {loader && <span class="tag">{loader}</span>}
        <span class="tag">{item.gameVersion}</span>
        <span class="tag">⬇ {formatNumber(item.downloads)}</span>
        <span class="tag">★ {formatNumber(item.stars)}</span>
      </div>
    </div>

    <div class="layout">
      <div class="box">
        <div class="tabs">
          {t.mod.tabs.map((tab, i) => <span class:list={{ on: i === 0 }}>{tab}</span>)}
        </div>

        <h2>{t.mod.features}</h2>
        <ul>
          {item.feat.map((f) => <li>{f}</li>)}
        </ul>
      </div>

      <aside>
        <div class="box">
          <a class="btn block" href={localePath(lang, `/download/${type.id}/${item.id}`)}
            data-url={downloadUrl}>{t.mod.download}</a>
          <dl>
            <dt>{t.mod.version}</dt>
            <dd>{version}</dd>
            <dt>{t.mod.fileSize}</dt>
            <dd>{item.size}</dd>
            <dt>{t.mod.released}</dt>
            <dd>{item.date}</dd>
            <dt>{t.mod.author}</dt>
            <dd>{item.author}</dd>
            <dt>{t.mod.license}</dt>
            <dd>MIT</dd>
          </dl>
        </div>
      </aside>
    </div>
  </main>
</Global>
