      <small>Annonse</small><div class="big">🧰</div><b>1000 mods på en gang!</b><p>Last ned alle mods gratis</p><span class="gbtn">DOWNLOAD</span></div>
  </aside>
</div>

<div class="modal" id="snapmodal" hidden><div class="sbox">
  <button class="sx" id="sclose" aria-label="Lukk">✕</button>
  <div class="sphoto">
    <img id="simg" alt="">
    <span class="sfallback" id="sfb">📷</span>
    <span class="son">● Pålogget nå</span>
  </div>
  <h2 id="sname"></h2>
  <p class="sdist" id="sdist"></p>
  <p class="smsg">«Hei! Jeg er alene hjemme i kveld 😘 Legg meg til på Snapchat så snakkes vi!»</p>
  <div class="ssnap">👻 Snapchat: <b id="ssnap"></b></div>
  <a class="sadd" data-fake data-why="Dette er en klassisk romansesvindel: en «person» med pent bilde vil flytte samtalen til en annen app. Målet er å bygge tillit og senere be om penger, bilder eller kortinfo. Bildet er ofte stjålet. Ikke legg til ukjente som kontakter deg ut av det blå." data-url="https://www.snapchat.com/add/hot-singles-lokal">LEGG TIL PÅ SNAPCHAT</a>
  <small class="sfoot">Annonse · 18+ · Over 2 300 singler online</small>
  </div></div>
<div class="modal" id="modal" hidden><div class="mbox">
  <h2>❌ Falsk lenke!</h2>
  <p id="why"></p>
  <p class="addr">Adressen var: <code id="addr"></code></p>
  <button id="mok">Prøv igjen</button>
</div></div>

<footer class="ff">
  <div class="fw">Et skoleprosjekt om sikker nedlasting. FilDeling er en fiktiv 
    side for opplæring · ingen ekte filer eller skadevare
  </div>
</footer>

<script>
(function(){
  store.set("fakeClicks", store.get("fakeClicks", 0));
  const m = MODS.find(x => x.id === new URLSearchParams(location.search).get("id")) || MODS[0];
  store.set("lastMod", m.id);
  const fn = fileName(m);
  document.title = "FilDeling – Last ned " + fn;
  document.getElementById("fn").textContent = fn;
  document.getElementById("fm").textContent = m.size + " · Lastet opp av " + m.author + " · " + m.date;
  document.getElementById("rl").textContent = "Last ned (" + m.size + ")";
  document.querySelector("[data-real]").dataset.url = "https://download.fildeling.example/file/k3x9q2/" + fn;
  document.getElementById("fi").textContent = "Filtype: ." + fn.split(".").pop() + " · Størrelse: " + m.size + " · Delt via lenke fra modhavn.example";
  // Bland rekkefølgen på knappene hver gang siden lastes
  const zone = document.getElementById('zone');
  [...zone.children].sort(() => Math.random() - .5).forEach(c => zone.appendChild(c));

  // Nedtelling
  let n = 5; const cd = document.getElementById('cd');
  const t = setInterval(() => { n--; cd.textContent = Math.max(n, 0); if (n <= 0) clearInterval(t); }, 1000);

  // Falsk virusvarsel etter litt tid
  setTimeout(() => { document.getElementById('vir').hidden = false; }, 3500);
  document.getElementById('vclose').onclick = () => { document.getElementById('vir').hidden = true; };

  const modal = document.getElementById('modal');
  const snap = document.getElementById('snapmodal');
  const img = document.getElementById('simg'), fb = document.getElementById('sfb');
  img.onerror = () => { img.style.display = 'none'; fb.style.display = 'grid'; };
  img.onload = () => { img.style.display = 'block'; fb.style.display = 'none'; };
  document.getElementById('sname').textContent = SINGLE_AD.name + ', ' + SINGLE_AD.age;
  document.getElementById('sdist').textContent = '📍 ' + SINGLE_AD.distance;
  document.getElementById('ssnap').textContent = '@' + SINGLE_AD.snap;
  document.getElementById('sclose').onclick = () => { snap.hidden = true; };
  document.addEventListener('click', e => {
    if (e.target.closest('[data-popup]')) { e.preventDefault(); img.src = SINGLE_AD.image; snap.hidden = false; store.set('fakeClicks', store.get('fakeClicks', 0) + 1); }
  });
  document.addEventListener('click', e => {
    const fake = e.target.closest('[data-fake]');
    const real = e.target.closest('[data-real]');
    if (fake) {
      e.preventDefault();
      const seen = store.get('seen', []);
      if (!seen.includes(fake.dataset.url)) { seen.push(fake.dataset.url); store.set('seen', seen); }
      store.set('fakeClicks', store.get('fakeClicks', 0) + 1);
      document.getElementById('why').textContent = fake.dataset.why;
      document.getElementById('addr').textContent = fake.dataset.url;
      snap.hidden = true; modal.hidden = false;
    } else if (real) {
      e.preventDefault();
      location.href = 'result.html';
    }
  });
  document.getElementById('mok').onclick = () => { modal.hidden = true; };
  document.getElementById('hint').onclick = e => { e.preventDefault(); document.getElementById('hinttxt').hidden = false; store.set('hint', true); };
})();
</script>
  </body>
</html>
<style>
  /* ===== Grunnoppsett ===== */
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #e9eef5;
    color: #222;
    font: 14px/1.45 Arial, Helvetica, sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .fw {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 12px;
  }

  /* ===== Toppbanner ===== */
  .topad {
    display: block;
    background: #ffe600;
    color: #900;
    text-align: center;
    padding: 10px;
    font-weight: 700;
    cursor: pointer;
    animation: flash 1s infinite;
  }

  @keyframes flash {
    50% {
      background: #ff5252;
      color: #fff;
    }
  }

  /* ===== Header ===== */
  .fh {
    background: #0070ff;
    color: #fff;
  }

  .fh .fw {
    display: flex;
    align-items: center;
    height: 52px;
  }

  .flogo {
    font-weight: 900;
    font-size: 24px;
    letter-spacing: -1px;
  }

  .fh nav {
    margin-left: auto;
    display: flex;
    gap: 18px;
    font-weight: 700;
  }

  .fh .up {
    background: #fff;
    color: #0070ff;
    border-radius: 4px;
    padding: 5px 12px;
  }

  /* ===== Layout ===== */
  .cols {
    display: grid;
    grid-template-columns: 170px 1fr 170px;
    gap: 14px;
    margin-top: 14px;
  }

  .main {
    background: #fff;
    border: 1px solid #cfd8e3;
    border-radius: 6px;
    padding: 20px;
    min-width: 0;
  }

  /* ===== Filinfo ===== */
  .file {
    display: flex;
    gap: 14px;
    align-items: center;
    border-bottom: 1px solid #e3e8ef;
    padding-bottom: 14px;
    margin-bottom: 12px;
  }

  .fi {
    font-size: 44px;
  }

  .file h1 {
    margin: 0;
    font-size: 20px;
    word-break: break-all;
  }

  .file p {
    margin: 2px 0 0;
    color: #667;
  }

  .timer {
    text-align: center;
    color: #c00;
    font-weight: 700;
    margin: 6px 0 14px;
  }

  /* ===== Nedlastingsknapper ===== */
  .btnzone {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    margin: 8px 0 18px;
  }

  .dl {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 440px;
    padding: 16px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 18px;
    color: #fff;
    text-align: center;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.2);
  }

  .dl:hover {
    filter: brightness(1.08);
  }

  .dl small {
    font-weight: 400;
    font-size: 12px;
    opacity: 0.9;
  }

  .dl-green {
    background: linear-gradient(#3ee05a, #18a634);
    font-size: 22px;
    padding: 22px;
  }

  .dl-orange {
    background: linear-gradient(#ffa73c, #f06a00);
  }

  .dl-real {
    background: #0070ff;
    max-width: 300px;
    padding: 12px;
    font-size: 16px;
  }

  .dl-grey {
    background: #555;
    font-size: 15px;
  }

  .dl-blue {
    background: linear-gradient(#5aa5ff, #2d6fe0);
    font-size: 15px;
  }

  .adtag {
    background: #fff;
    color: #888;
    border-radius: 3px;
    padding: 0 5px;
    margin-top: 3px;
    font-size: 9px !important;
  }

  /* ===== Annonser ===== */
  .ad {
    background: #fff;
    border: 1px solid #cfd8e3;
    border-radius: 6px;
    padding: 10px;
    text-align: center;
    margin-bottom: 14px;
    cursor: pointer;
  }

  .ad small {
    display: block;
    text-align: right;
    color: #aaa;
    font-size: 9px;
  }

  .ad .big {
    font-size: 40px;
  }

  .ad p {
    margin: 4px 0 8px;
    font-size: 12px;
  }

  .ad:hover {
    border-color: #f90;
  }

  .gbtn {
    display: inline-block;
    background: #e22;
    color: #fff;
    font-weight: 700;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 12px;
  }

  .gbtn.blue {
    background: #07f;
  }

  .gbtn.pink {
    background: #e0237a;
  }

  .ad.wide {
    background: #111;
    color: #0f0;
    padding: 14px;
  }

  .ad.wide small {
    color: #666;
  }

  .blink {
    font-weight: 900;
