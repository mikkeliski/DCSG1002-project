      opacity: 0.3;
    }
  }

  /* ===== Info og hint ===== */
  .info {
    background: #f5f8fc;
    border-radius: 6px;
    padding: 10px 14px;
    margin-top: 6px;
  }

  .info h3 {
    margin: 0 0 4px;
    font-size: 14px;
  }

  .info p {
    margin: 0;
