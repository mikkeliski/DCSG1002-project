    cursor: pointer;
    border-radius: 4px;
  }

  .alertpop button.x {
    background: #ddd;
    color: #444;
    margin-left: 6px;
  }

  /* ===== Modal ===== */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    display: grid;
    place-items: center;
    z-index: 100;
  }

  .modal[hidden],
  [hidden] {
    display: none !important;
  }

  .mbox {
    background: #fff;
    max-width: 480px;
    margin: 16px;
    padding: 24px;
    border-radius: 10px;
    border-top: 6px solid #d00;
  }

  .mbox h2 {
    margin-top: 0;
    color: #b00;
  }

  .addr code {
    background: #f1f1f1;
    padding: 2px 6px;
    border-radius: 4px;
    word-break: break-all;
    font-size: 12px;
  }

  .mbox button {
    background: #0070ff;
    color: #fff;
    border: 0;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: 700;
    cursor: pointer;
    margin-top: 8px;
  }

  /* ===== Footer ===== */
  .ff {
    padding: 24px 0;
    color: #778;
    font-size: 12px;
    text-align: center;
  }

  /* ===== Statuslinje ===== */
  #statusbar {
    position: fixed;
    left: 0;
    bottom: 0;
    z-index: 9999;
    max-width: 80vw;
    padding: 3px 10px;
    background: #f1f3f4;
    color: #222;
    font: 12px system-ui;
    border: 1px solid #c9ccd0;
    border-left: 0;
    border-bottom: 0;
    border-radius: 0 6px 0 0;
    opacity: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #statusbar.show {
    opacity: 1;
  }

  /* ===== Responsivt ===== */
  @media (max-width: 850px) {
    .cols {
      grid-template-columns: 1fr;
    }

    .side {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
  }

  /* ===== Popup-kort ===== */
  .sbox {
    position: relative;
    width: 340px;
    max-width: 92vw;
    max-height: 96vh;
    padding-bottom: 16px;
    background: #fff;
    border: 3px solid #ff2d87;
    border-radius: 14px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    text-align: center;
    overflow-x: hidden;
    overflow-y: auto;
  }

  .sx {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    width: 28px;
    height: 28px;
