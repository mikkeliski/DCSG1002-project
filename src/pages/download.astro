---
---
<html lang="no">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>FilDeling – Last ned fil</title>
    <link rel="stylesheet" href="fildeling.css">
  </head>
  <body>
    <div class="topad" data-fake data-why="Dette er en annonse som ser ut som 
                en systemvarsling. Sider kan ikke vite om PC-en din har virus. 
                Det er en klassisk skremmetaktikk for å få deg til å installere 
                noe." 
                data-url="http://pc-sjekk-gratis.example/scan?id=8841">
      ⚠️ <b>ADVARSEL:</b>
      PC-en din kan være infisert med 7 virus! 
      <u>Klikk her for gratis skanning</u>
    </div>
    <header class="fh">
      <div class="fw">
        <span class="flogo">FilDeling</span>
        <nav><a>Logg inn</a><a>Premium</a><a class="up">Last opp</a></nav></div>
    </header>
    <div class="fw cols">
      <aside class="side">
        <div class="ad" data-fake data-why="Gevinstannonser er nesten alltid 
                    svindel. Du har ikke vunnet noe, og målet er å få deg til å 
                    oppgi personopplysninger eller kortinfo." 
                    data-url="http://gratis-iphone-vinner.example/claim">
          <small>Annonse</small>
          <div class="big">🎁</div>
          <b>GRATULERER!</b>
          <p>Du er besøkende nr. 1 000 000!</p>
          <span class="gbtn">KREV GEVINST</span>
        </div>
        <div class="ad" data-fake data-why="Slike «oppdater nå»-knapper på 
                    tilfeldige nettsider leverer ofte skadevare. Oppdater alltid 
                    programmer fra produsentens egen side eller via programmet 
                    selv." 
                    data-url="http://java-oppdatering-na.example/JavaSetup.exe">
          <small>Annonse</small>
          <div class="big">☕</div>
          <b>Java må oppdateres</b>
          <p>Din versjon er utdatert og farlig.</p>
          <span class="gbtn blue">OPPDATER</span>
        </div>
      </aside>
      <main class="main">
        <div class="file">
          <div class="fi">📦</div>
          <div><h1 id="fn"></h1><p id="fm"></p></div>
        </div>
        <div class="alertpop" id="vir" hidden>
          <b>🛑 VIRUS OPPDAGET</b>
          <p>Trojan.Gen.2 ble funnet på enheten din. Fjern nå!</p>
          <button data-fake 
          data-why="Falsk virusvarsel i nettleseren. Nettsider kan ikke skanne 
                    maskinen din. Ekte antivirus varsler deg fra programmet, 
                    ikke fra en nettside." 
          data-url="http://virus-fjerner-pro.example/RemoveNow.exe"
          >
            FJERN VIRUS
          </button>
      <button class="x" id="vclose">Lukk</button>
    </div>
    <p class="timer">Nedlastingen din er klar om <b id="cd">5</b> sekunder…</p>
    <div class="btnzone" id="zone">
      <a class="dl dl-green" data-fake data-why="Stor, grønn «Start Download» 
                med ekstra pil. Adressen går til en helt annen side og filen 
                heter .exe, ikke .jar. En mod skal aldri være en 
                installasjonsfil." 
                data-url="http://fast-dl-boost.example/get/DownloadManager_Setup.exe">
        <span>⬇ START NEDLASTING</span><small>Rask nedlasting · Anbefalt</small></a>
      <a class="dl dl-orange" data-fake data-why="Her står det «Download Now», men det er en annonse. Se etter den lille «Annonse»-merkingen. Adressen peker til en tredjepart." data-url="http://best-downloads-2026.example/redirect?f=superdiamant">
        <span>DOWNLOAD NOW</span><small class="adtag">Annonse</small></a>
      <a class="dl dl-real" data-real data-url="https://download.fildeling.example/file/k3x9q2/super-diamant-plus-2.4.1.jar">
        <span id="rl">Last ned</span></a>
      <a class="dl dl-grey" data-fake data-why="«Last ned med Premium» prøver å selge deg et abonnement og en «nedlastingsbehandler». Du trenger ingen av delene for en liten fil." data-url="http://fildeling-premium-rask.example/checkout">
        <span>⚡ Premium-nedlasting – 10x raskere</span></a>
      <a class="dl dl-blue" data-fake data-why="Falsk avspillingsknapp / «videospiller». Kommer ofte med påstanden om at du må installere en kodek eller utvidelse. Det trenger du ikke." data-url="http://video-codec-pack.example/install-extension">
        <span>▶ Se video først (kodek kreves)</span></a>
    </div>

    <div class="ad wide" data-fake data-why="En bannerannonse som imiterer en nedlastingsknapp. Alt som blinker og lover «100 % gratis» er mistenkelig." data-url="http://free-vpn-ultra.example/download.apk">
      <small>Annonse</small><span class="blink">⬇ DOWNLOAD – 100% GRATIS VPN – DOWNLOAD ⬇</span></div>

    <div class="info">
      <h3>Om filen</h3>
      <p id="fi">…</p>
    </div>
    <p class="hintrow">Står du fast? <a href="#" id="hint">Vis hint</a></p>
    <p class="hinttxt" id="hinttxt" hidden>Hint: Hold musepekeren over knappene og les adressen nederst til venstre. Den ekte filen ender på <b>.jar</b>, ligger på FilDelings eget domene, og knappen har ingen «annonse»-merking.</p>
  </main>

  <aside class="side">
    <div class="ad" data-popup data-url="http://singler-i-ditt-omrade.example/chat">
      <small>Annonse</small><div class="big">🔥</div><b>Single i ditt område</b><p>Vil chatte nå?</p><span class="gbtn pink">START</span></div>
    <div class="ad" data-fake data-why="Falsk «Download»-knapp i en sidebar-annonse. Teksten i knappen sier ikke noe om hva adressen faktisk er." data-url="http://mega-mods-pack.example/all-mods.zip">
      <small>Annonse</small><div class="big">🧰</div><b>1000 mods på en gang!</b><p>Last ned alle mods gratis</p><span class="gbtn">DOWNLOAD</span></div>
  </aside>
</div>

<div class="modal" id="snapmodal" hidden><div class="sbox">
  <button class="sx" id="sclose" aria-label="Lukk">✕</button>
  <div class="sphoto">
    <img id="simg" alt="">
    <span class="sfallback" id="sfb">📷</span>
    <span class="son">● Pålogget nå</span>
  </div>
  <h2 id="sname"></h2>
  <p class="sdist" id="sdist"></p>
  <p class="smsg">«Hei! Jeg er alene hjemme i kveld 😘 Legg meg til på Snapchat så snakkes vi!»</p>
  <div class="ssnap">👻 Snapchat: <b id="ssnap"></b></div>
  <a class="sadd" data-fake data-why="Dette er en klassisk romansesvindel: en «person» med pent bilde vil flytte samtalen til en annen app. Målet er å bygge tillit og senere be om penger, bilder eller kortinfo. Bildet er ofte stjålet. Ikke legg til ukjente som kontakter deg ut av det blå." data-url="https://www.snapchat.com/add/hot-singles-lokal">LEGG TIL PÅ SNAPCHAT</a>
  <small class="sfoot">Annonse · 18+ · Over 2 300 singler online</small>
  </div></div>
<div class="modal" id="modal" hidden><div class="mbox">
  <h2>❌ Falsk lenke!</h2>
  <p id="why"></p>
  <p class="addr">Adressen var: <code id="addr"></code></p>
  <button id="mok">Prøv igjen</button>
</div></div>

<footer class="ff">
  <div class="fw">Et skoleprosjekt om sikker nedlasting. FilDeling er en fiktiv 
    side for opplæring · ingen ekte filer eller skadevare
  </div>
</footer>

<script>
(function(){
  store.set("fakeClicks", store.get("fakeClicks", 0));
  const m = MODS.find(x => x.id === new URLSearchParams(location.search).get("id")) || MODS[0];
  store.set("lastMod", m.id);
  const fn = fileName(m);
  document.title = "FilDeling – Last ned " + fn;
  document.getElementById("fn").textContent = fn;
  document.getElementById("fm").textContent = m.size + " · Lastet opp av " + m.author + " · " + m.date;
  document.getElementById("rl").textContent = "Last ned (" + m.size + ")";
  document.querySelector("[data-real]").dataset.url = "https://download.fildeling.example/file/k3x9q2/" + fn;
  document.getElementById("fi").textContent = "Filtype: ." + fn.split(".").pop() + " · Størrelse: " + m.size + " · Delt via lenke fra modhavn.example";
  // Bland rekkefølgen på knappene hver gang siden lastes
  const zone = document.getElementById('zone');
  [...zone.children].sort(() => Math.random() - .5).forEach(c => zone.appendChild(c));

  // Nedtelling
  let n = 5; const cd = document.getElementById('cd');
  const t = setInterval(() => { n--; cd.textContent = Math.max(n, 0); if (n <= 0) clearInterval(t); }, 1000);

  // Falsk virusvarsel etter litt tid
  setTimeout(() => { document.getElementById('vir').hidden = false; }, 3500);
  document.getElementById('vclose').onclick = () => { document.getElementById('vir').hidden = true; };

  const modal = document.getElementById('modal');
  const snap = document.getElementById('snapmodal');
  const img = document.getElementById('simg'), fb = document.getElementById('sfb');
  img.onerror = () => { img.style.display = 'none'; fb.style.display = 'grid'; };
  img.onload = () => { img.style.display = 'block'; fb.style.display = 'none'; };
  document.getElementById('sname').textContent = SINGLE_AD.name + ', ' + SINGLE_AD.age;
  document.getElementById('sdist').textContent = '📍 ' + SINGLE_AD.distance;
  document.getElementById('ssnap').textContent = '@' + SINGLE_AD.snap;
  document.getElementById('sclose').onclick = () => { snap.hidden = true; };
  document.addEventListener('click', e => {
    if (e.target.closest('[data-popup]')) { e.preventDefault(); img.src = SINGLE_AD.image; snap.hidden = false; store.set('fakeClicks', store.get('fakeClicks', 0) + 1); }
  });
  document.addEventListener('click', e => {
    const fake = e.target.closest('[data-fake]');
    const real = e.target.closest('[data-real]');
    if (fake) {
      e.preventDefault();
      const seen = store.get('seen', []);
      if (!seen.includes(fake.dataset.url)) { seen.push(fake.dataset.url); store.set('seen', seen); }
      store.set('fakeClicks', store.get('fakeClicks', 0) + 1);
      document.getElementById('why').textContent = fake.dataset.why;
      document.getElementById('addr').textContent = fake.dataset.url;
      snap.hidden = true; modal.hidden = false;
    } else if (real) {
      e.preventDefault();
      location.href = 'result.html';
    }
  });
  document.getElementById('mok').onclick = () => { modal.hidden = true; };
  document.getElementById('hint').onclick = e => { e.preventDefault(); document.getElementById('hinttxt').hidden = false; store.set('hint', true); };
})();
</script>
  </body>
</html>
