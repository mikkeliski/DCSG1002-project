---
import { Global } from '@layouts/Global.astro';

---
<Global title="ModHavn – Treningsområde for trygg nedlasting">
  <section class="banner">
    <div class="wrap">
      <h1>Finn mods til Minecraft</h1>
      <p>
        ModHavn er en <b>øvingsside</b> laget i et cybersikkerhetsprosjekt. Velg 
        en mod, last den ned, og se om du klarer å finne den ekte 
        nedlastingslenken på veien.
      </p>
    </div>
  </section>
  <main class="wrap">
    <div class="rh">
      <h2 id="title"></h2>
      <span class="tag" id="count">
      </span>
    </div>
    <div class="grid" id="grid"></div>
    <div class="note">
      Ingen ekte filer lastes ned, og ingenting installeres på maskinen din. 
      Alle mods på siden er fiktive.
    </div>
  </main>
  <Footer />
<script src="data.js"></script>
<script src="common.js"></script>
<script>
const params = new URLSearchParams(location.search);
const type = TYPES[params.get('type')] ? params.get('type') : '';
const q = (params.get('q') || '').trim();
renderHeader(type, q);

const norm = s => s.toLowerCase();
let list = MODS.filter(m => !type || m.type === type);
if (q) list = list.filter(m => norm([m.name, m.desc, m.author, m.loader, m.ver, TYPES[m.type].label].join(' ')).includes(norm(q)));
list.sort((a, b) => b.dls - a.dls);

document.getElementById('title').textContent = q ? 'Søkeresultater for «' + q + '»' : (type ? TYPES[type].label : 'Populære mods og innhold');
document.getElementById('count').textContent = list.length + (list.length === 1 ? ' treff' : ' treff');
document.title = (type ? TYPES[type].label : 'ModHavn') + ' – ModHavn';

const grid = document.getElementById('grid');
if (!list.length) { grid.innerHTML = '<div class="empty">Ingen treff. Prøv et annet søkeord, for eksempel «diamant» eller «Fabric».</div>'; grid.style.display = 'block'; }
list.forEach(m => {
  const a = document.createElement('a'); a.className = 'card'; a.href = 'mod.html?id=' + m.id;
  const ic = document.createElement('div'); ic.className = 'icon'; ic.style.background = m.color; ic.textContent = m.icon;
  const d = document.createElement('div');
  const h = document.createElement('h3'); h.textContent = m.name;
  const p = document.createElement('p'); p.textContent = m.desc;
  d.append(h, p);
  [TYPES[m.type].label.replace(/er$|r$/, ''), m.loader, m.ver, '⬇ ' + fmt(m.dls)].filter(x => x !== '–').forEach(t => {
    const s = document.createElement('span'); s.className = 'tag'; s.textContent = t; d.appendChild(s);
  });
  a.append(ic, d); grid.appendChild(a);
});
</script>
</Global>
