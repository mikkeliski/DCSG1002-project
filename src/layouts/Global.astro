---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
const { title } = Astro.props;
---

<html lang="no">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
<style>
  :root {
    --bg: #16181c;
    --panel: #1e2126;
    --panel2: #262a31;
    --line: #323741;
    --text: #e6e8eb;
    --mute: #9aa1ad;
    --green: #1bd96a;
    --green-d: #13a850;
  }

  /* ===== Grunnoppsett ===== */
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 15px/1.5 system-ui, "Segoe UI", sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 16px;
  }

  /* ===== Søkefelt ===== */
  .nav input {
    margin-left: auto;
    width: 240px;
    padding: 8px 12px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text);
  }

  .sf {
    margin-left: auto;
    display: flex;
  }

  .sf input {
    margin-left: 0;
  }

  /* ===== Banner ===== */
  .banner {
    background: linear-gradient(135deg, #16341f, #1b2a3a);
    border-bottom: 1px solid var(--line);
    padding: 32px 0;
  }

  .banner h1 {
    margin: 0 0 8px;
    font-size: 30px;
  }

  .banner p {
    margin: 0;
    max-width: 700px;
    color: #c3cad4;
  }

  .tag {
    display: inline-block;
    margin-right: 6px;
    padding: 2px 10px;
    background: var(--panel2);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--mute);
    font-size: 12px;
  }

  /* ===== Kortrutenett ===== */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 14px;
    margin: 24px 0;
  }

  .card {
    display: flex;
    gap: 12px;
    padding: 14px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .card:hover {
    border-color: var(--green);
  }

  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 12px;
    font-size: 34px;
  }

  .card h3 {
    margin: 0;
  }

  .card p {
    margin: 4px 0 8px;
    color: var(--mute);
    font-size: 14px;
  }

  /* ===== Sideoppsett ===== */
  .layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 20px;
    margin: 24px 0;
  }

  .box {
    padding: 20px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .box h2 {
    margin-top: 0;
  }

  /* ===== Detaljside ===== */
  .hero {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 24px 0 8px;
  }

  .hero .icon {
    width: 96px;
    height: 96px;
    font-size: 48px;
  }

  .hero h1 {
    margin: 0;
  }

  .tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .tabs span {
    padding: 10px 16px;
    color: var(--mute);
    font-weight: 600;
    border-bottom: 2px solid transparent;
  }

  .tabs span.on {
    color: var(--green);
    border-color: var(--green);
  }

  /* ===== Knapper ===== */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    background: var(--green);
    color: #06210f;
    font-weight: 700;
    font-size: 16px;
    border: 0;
    border-radius: 10px;
    cursor: pointer;
  }

  .btn:hover {
    background: var(--green-d);
  }

  .btn.block {
    width: 100%;
    justify-content: center;
  }

  /* ===== Detaljliste ===== */
  dl {
    margin: 0;
  }

  dt {
    margin-top: 12px;
    color: var(--mute);
    font-size: 12px;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-weight: 600;
  }

  /* ===== Skjermbilde og merknad ===== */
  .shot {
    display: grid;
    place-items: center;
    height: 200px;
    margin: 12px 0;
    border-radius: 10px;
    background: linear-gradient(#6fb1ff 0 55%, #5b8a3a 55% 70%, #7a5a3a 70%);
    color: #fff;
    font-size: 60px;
  }

  .note {
    margin-top: 16px;
    padding: 12px 14px;
    background: #1d2b3d;
    border: 1px solid #2f4a6b;
    border-radius: 10px;
    color: #b7d3f5;
    font-size: 14px;
  }

  /* ===== Søkeresultater ===== */
  .rh {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0 0;
  }

  .rh h2 {
    margin: 0;
  }

  .empty {
    padding: 40px 0;
    color: var(--mute);
    text-align: center;
  }

  /* ===== Footer ===== */
  /* ===== Statuslinje ===== */
  #statusbar {
    position: fixed;
    left: 0;
    bottom: 0;
    z-index: 9999;
    max-width: 80vw;
    padding: 3px 10px;
    background: #f1f3f4;
    color: #222;
    font: 12px system-ui;
    border: 1px solid #c9ccd0;
    border-left: 0;
    border-bottom: 0;
    border-radius: 0 6px 0 0;
    opacity: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #statusbar.show {
    opacity: 1;
  }

  /* ===== Responsivt ===== */
  @media (max-width: 800px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .nav {
      gap: 12px;
      overflow-x: auto;
    }

    .nav input {
      display: none;
    }

    .nav .sf input {
      display: block;
      width: 140px;
    }
  }
</style>
</html>
 
