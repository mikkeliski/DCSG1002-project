---
// Den falske fildelingssiden. Egen layout fordi den skal se ut som en annen
// nettside enn ModHavn (lyst tema, ingen ModHavn-meny).
import StatusBar from '@components/StatusBar.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot name="banner" />
    <header class="fh">
      <div class="fw">
        <span class="flogo">FilDeling</span>
        <nav><a>Logg inn</a><a>Premium</a><a class="up">Last opp</a></nav>
      </div>
    </header>
    <slot />
    <footer class="ff">
      <div class="fw">
        Et skoleprosjekt om sikker nedlasting. FilDeling er en fiktiv side for opplæring · ingen
        ekte filer eller skadevare
      </div>
    </footer>
    <StatusBar />
  </body>
</html>

<style is:global>
  /* ===== Grunnoppsett ===== */
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #e9eef5;
    color: #222;
    font: 14px/1.45 Arial, Helvetica, sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  [hidden] {
    display: none !important;
  }

  .fw {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 12px;
  }
</style>

<style>
  /* ===== Header ===== */
  .fh {
    background: #0070ff;
    color: #fff;
  }

  .fh .fw {
    display: flex;
    align-items: center;
    height: 52px;
  }

  .flogo {
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -1px;
  }

  nav {
    display: flex;
    gap: 18px;
    margin-left: auto;
    font-weight: 700;
  }

  .up {
    padding: 5px 12px;
    background: #fff;
    color: #0070ff;
    border-radius: 4px;
  }

  /* ===== Footer ===== */
  .ff {
    padding: 24px 0;
    color: #778;
    font-size: 12px;
    text-align: center;
  }
</style>
